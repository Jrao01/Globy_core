' =========================================
' MODULO 1: Autenticacion, Seguridad y Acceso
' =========================================
@startuml M01_Autenticacion

skinparam monochrome true
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor Black
skinparam ActorBorderColor Black
skinparam UseCaseBorderColor Black
skinparam ActorBackgroundColor White
skinparam UseCaseBackgroundColor White

title Modulo 1 — Autenticacion, Seguridad y Acceso\n[Sistema Globy]

actor Administrador as ADM
actor Gerente       as GER
actor Trabajador    as TRB
actor Delivery      as DEL
actor Cliente       as CLI

package "Autenticacion, Seguridad y Acceso" {
    usecase "Iniciar Sesion\n(Personal)"        as UC01
    usecase "Cerrar Sesion"                     as UC02
    usecase "Validar Token JWT\n(24 horas)"     as UC03
    usecase "Restringir Acceso\npor Rol"        as UC04
    usecase "Iniciar Sesion\n(Cliente)"         as UC05
    usecase "Registrar Cliente"                 as UC06

    UC01 ..> UC03 : <<include>>
    UC01 ..> UC04 : <<include>>
    UC05 ..> UC03 : <<include>>
}

ADM --> UC01
ADM --> UC02
GER --> UC01
GER --> UC02
TRB --> UC01
TRB --> UC02
DEL --> UC01
DEL --> UC02
CLI --> UC05
CLI --> UC06
CLI --> UC02

@enduml


