generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

// --- CONFIGURACIÓN GLOBAL DE LA EMPRESA ---
model EmpresaConfig {
  id              Int      @id @default(1)
  nombreEmpresa   String
  rif             String   @unique
  direccionFiscal String
  telefono        String?
  logoUrl         String?
  pais            String   @default("Venezuela")
  
  // Color primario personalizado (hex, ej: #5713be)
  colorPrimario   String   @default("#5713be")

  // Datos de Pago Móvil
  pagoMovilBanco        String?
  pagoMovilCedulaTipo   String?
  pagoMovilCedula       String?
  pagoMovilTelefono     String?

  // Banner de la tienda pública
  bannerImg       String?
  bannerTitle     String?
  bannerSubtitle  String?

  // Configuración SMTP para envío de correos automáticos
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPass        String?

  // Configuración de entregas
  costoPorKm          Float    @default(0)
  precioMinimoEntrega Float    @default(0)
  
  updatedAt       DateTime @updatedAt
}

// --- GESTIÓN DE USUARIOS Y ACCESO ---
model Cliente {
  id           Int          @id @default(autoincrement())
  googleId     String?      @unique
  nombre       String
  apellido     String
  cedula       String       @unique
  correo       String       @unique
  password     String
  telefono     String?
  direccion    String?
  tipoCliente  String       @default("bronce")
  coordenadasLat Float?
  coordenadasLng Float?
  conexiones   Conexion[]
  compras      Compra[]
  chats        Chat[]
  createdAt    DateTime     @default(now())
}

enum PersonalRol {
  admin
  gerente
  trabajador
  delivery
}

model TipoPersonal {
  id           Int        @id @default(autoincrement())
  nombre       String     @unique
  pagaMensual  Float
  status       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  personal     Personal[]
}

model Personal {
  id              Int          @id @default(autoincrement())
  nombre          String
  apellido        String
  cedula          String       @unique
  correo          String       @unique
  password        String
  telefono        String?
  rol             PersonalRol  @default(trabajador)
  status          Boolean      @default(true)
  sucursalId      Int?
  sucursal        Sucursal?    @relation(fields: [sucursalId], references: [id])
  tipoPersonalId  Int?
  tipoPersonal    TipoPersonal? @relation(fields: [tipoPersonalId], references: [id])
  sueldoMensual   Float?         // Override del sueldo del tipo de personal
  comprasAsignadas Compra[]     @relation("Repartidor")
  chats           Chat[]
  createdAt       DateTime     @default(now())
}

// --- INFRAESTRUCTURA Y MERCADO ---
model Sucursal {
  id              Int          @id @default(autoincrement())
  nombre          String
  ciudad          String
  direccion       String
  coordenadasLat  Float
  coordenadasLng  Float
  tipo            String       @default("secundaria")
  status          Boolean      @default(true)
  personal        Personal[]
  inventarios     Inventario[]
  compras         Compra[]
  informes        InformeAnalitico[]
  ofertas         OfertaSucursal[]
}

model Competidor {
  id              Int      @id @default(autoincrement())
  nombre          String
  ciudad          String
  direccion       String?
  coordenadasLat  Float
  coordenadasLng  Float
  cantReviews     Int      @default(0)
  ratingPromedio  Float?
  tipoNegocio     String?
  categories      String?  // JSON array serializado
  placeId         String?  @unique
  website         String?
  phone           String?
  ultimaVerif     DateTime @default(now())
  busquedas       CompetidoresBusqueda[]
}

model BusquedaCompetidor {
  id              Int                    @id @default(autoincrement())
  categorias      String                 // JSON array de categorías buscadas
  ciudades        String                 // JSON array de ciudades
  maxPlaces       Int
  createdAt       DateTime               @default(now())
  competidores    CompetidoresBusqueda[]

  @@unique([categorias, ciudades, maxPlaces])
}

model CompetidoresBusqueda {
  busquedaId       Int
  competidorId     Int
  busqueda         BusquedaCompetidor @relation(fields: [busquedaId], references: [id], onDelete: Cascade)
  competidor       Competidor         @relation(fields: [competidorId], references: [id], onDelete: Cascade)

  @@id([busquedaId, competidorId])
}

// --- PRODUCTOS E INVENTARIO ---
model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
  ofertas     Oferta[]
}

model Producto {
  id              Int               @id @default(autoincrement())
  nombre          String
  tipo            String
  descripcion     String?
  precioBase      Float
  moneda          String            @default("USD")
  costo           Float?            // Costo de adquisición por unidad
  emailProveedor  String
  imagen          String?
  categoriaId     Int
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])
  inventarios     Inventario[]
  detallesCompra  CompraDetalle[]
  ofertas         Oferta[]
  excepciones     OfertaExcepcion[]
}

model Inventario {
  id              Int       @id @default(autoincrement())
  sucursalId      Int
  productoId      Int
  stockActual     Int       @default(0)
  stockMinimo     Int       @default(5)
  cantVentas      Int       @default(0)
  estadoStock     String    @default("optimo")
  status          String    @default("disponible")
  ultimaReposicion DateTime @updatedAt

  sucursal        Sucursal  @relation(fields: [sucursalId], references: [id])
  producto        Producto  @relation(fields: [productoId], references: [id])

  @@unique([sucursalId, productoId])
}

// --- GEOIP CACHE (geolocalización por IP) ---
model GeoIP {
  id         Int          @id @default(autoincrement())
  ip         String       @unique
  proveedor  String?
  ciudad     String?
  pais       String?
  latitud    Float?
  longitud   Float?
  auditorias Auditoria[]
  updatedAt  DateTime     @updatedAt
}

// --- AUDITORÍA DE ACCESOS (todos los usuarios) ---
model Auditoria {
  id            Int      @id @default(autoincrement())
  ip            String
  ruta          String
  metodo        String
  clienteId     Int?
  personalId    Int?
  dispositivoId String?
  geoIPId       Int?
  geoIP         GeoIP?   @relation(fields: [geoIPId], references: [id])
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
  @@index([ruta])
}

// --- RECOLECCIÓN DE DATOS (SENSORES) ---
model Conexion {
  id            Int      @id @default(autoincrement())
  clienteId     Int?
  dispositivoId String?
  ip            String
  latitud       Float
  longitud      Float
  dispositivo   String?
  fecha         DateTime @default(now())
  cliente       Cliente? @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([fecha])
}

model Compra {
  id              Int             @id @default(autoincrement())
  clienteId       Int
  sucursalId      Int
  repartidorId    Int?
  total           Float
  tipo            String          @default("compra_web") // "compra_directa" | "compra_web"
  status          String          @default("pendiente")
  // Pago
  metodoPago      String?         // "transferencia" | "pago_movil" | "efectivo_bs" | "efectivo_usd"
  refPago         String?
  // Entrega
  direccionEntrega String?
  coordenadasLat  Float?
  coordenadasLng  Float?
  distanciaKm     Float?
  costoEnvio      Float?
  // Tracking del delivery
  repartidorCoordenadasLat Float?
  repartidorCoordenadasLng Float?
  ultimaActualizacionUbicacion DateTime?
  tasaCambio      Float?
  fecha           DateTime        @default(now())
  cliente         Cliente         @relation(fields: [clienteId], references: [id])
  sucursal        Sucursal        @relation(fields: [sucursalId], references: [id])
  repartidor      Personal?       @relation("Repartidor", fields: [repartidorId], references: [id])
  detalles        CompraDetalle[]
  chat            Chat?
  ubicacionesLog  UbicacionLog[]

  @@index([fecha])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([status])
  @@index([repartidorId])
}

model UbicacionLog {
  id        Int      @id @default(autoincrement())
  compraId  Int
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  compra    Compra   @relation(fields: [compraId], references: [id])

  @@index([compraId])
  @@index([createdAt])
}

model CompraDetalle {
  id         Int      @id @default(autoincrement())
  compraId   Int
  productoId Int
  cantidad   Int
  precioUnit Float
  costoUnit  Float?
  compra     Compra   @relation(fields: [compraId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])
}

// --- GESTIÓN ECONÓMICA ---
model GestionEconomica {
  id              Int      @id @default(autoincrement())
  monedaPrincipal String   @default("USD")
  autoUpdate      Boolean  @default(true)
}

model TasaCambio {
  id        Int      @id @default(autoincrement())
  moneda    String   // "USD" | "EUR"
  precio    Float
  fecha     DateTime @default(now())
}

// --- OFERTAS Y DESCUENTOS ---
model Oferta {
  id              Int                @id @default(autoincrement())
  nombre          String
  descripcion     String?
  tipo            String             // "porcentaje" | "monto_fijo"
  valor           Float              // 10 = 10% descuento, 5 = $5 descuento
  montoMinimo     Float?             // precio mínimo del producto para aplicar
  montoMaximo     Float?             // precio máximo del producto para aplicar
  fechaInicio     DateTime
  fechaFin        DateTime
  activo          Boolean            @default(true)
  prioridad       Int                @default(0)
  createdAt       DateTime           @default(now())

  categoriaId     Int?
  productoId      Int?
  categoria       Categoria?         @relation(fields: [categoriaId], references: [id])
  producto        Producto?          @relation(fields: [productoId], references: [id])

  sucursales      OfertaSucursal[]
  excepciones     OfertaExcepcion[]
}

model OfertaSucursal {
  ofertaId   Int
  sucursalId Int
  oferta     Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([ofertaId, sucursalId])
}

model OfertaExcepcion {
  ofertaId   Int
  productoId Int
  oferta     Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([ofertaId, productoId])
}

// --- POBLACIÓN DE CIUDADES ---
model CiudadPoblacion {
  id        Int    @id @default(autoincrement())
  nombre    String
  region    String // Estado
  poblacion Int
  latitud   Float
  longitud  Float

  @@unique([nombre, region])
  @@index([nombre])
}

// --- COEFICIENTES DE ESTACIONALIDAD POR MES ---
model CoeficienteFestividad {
  id                        Int   @id @default(autoincrement())
  mes                       Int   @unique // 1-12
  coeficienteConsumoMasivo  Float
  coeficienteTecnologia     Float
  coeficienteRopa           Float
  coeficienteRestaurantes   Float
  coeficientePromedio       Float // promedio de los 4 anteriores
  updatedAt                 DateTime @updatedAt
  updatedBy                 Int? // personalId del super admin
}

// --- SINERGIA DE CATEGORÍAS (CO-TENANCY MATRIX) ---
model CategoriaSinergia {
  id                Int      @id @default(autoincrement())
  categoriaEmpresa  String   // Categoría de producto de la empresa (ej: "Ropa Deportiva")
  categoriaTractora String   // Categoría de negocio complementario (ej: "Gimnasio")
  peso              Float    @default(1.0) // 0.5=bajo, 1.0=medio, 2.0=alto
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([categoriaEmpresa, categoriaTractora])
  @@index([categoriaEmpresa])
}

// --- INTELIGENCIA ARTIFICIAL ---
model InformeAnalitico {
  id               Int      @id @default(autoincrement())
  tipoAnalisis     String   // ventas, demanda_geo, comportamiento
  sucursalId       Int?
  rangoInicio      DateTime
  rangoFin         DateTime
  dataJson         Json     // Resultados del cruce de datos
  insightIA        Json?    
  cacheKey         String?   // Clave para cachear insights por parámetros
  createdAt        DateTime @default(now())
  sucursal         Sucursal? @relation(fields: [sucursalId], references: [id])

  @@index([createdAt])
  @@index([tipoAnalisis])
  @@index([sucursalId])
  @@index([cacheKey])
}

// --- CHAT DELIVERY-CLIENTE ---
model Chat {
  id            Int      @id @default(autoincrement())
  compraId      Int      @unique
  repartidorId  Int
  clienteId     Int
  createdAt     DateTime @default(now())
  compra        Compra   @relation(fields: [compraId], references: [id])
  repartidor    Personal @relation(fields: [repartidorId], references: [id])
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  mensajes      Mensaje[]

  @@index([compraId])
  @@index([repartidorId])
  @@index([clienteId])
}

model Mensaje {
  id           Int      @id @default(autoincrement())
  chatId       Int
  emisorTipo   String   // "delivery" | "cliente"
  emisorId     Int
  contenido    String
  createdAt    DateTime @default(now())
  chat         Chat     @relation(fields: [chatId], references: [id])

  @@index([chatId])
  @@index([createdAt])
}