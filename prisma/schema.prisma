generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

// --- CONFIGURACIÓN GLOBAL DE LA EMPRESA ---
model EmpresaConfig {
  id              Int      @id @default(1)
  nombreEmpresa   String
  rif             String   @unique
  direccionFiscal String
  telefono        String?
  logoUrl         String?
  pais            String   @default("Venezuela")
  
  // Configuración SMTP para envío de correos automáticos
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPass        String?
  
  updatedAt       DateTime @updatedAt
}

// --- GESTIÓN DE USUARIOS Y ACCESO ---
model Cliente {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  cedula       String       @unique
  correo       String       @unique
  password     String
  telefono     String?
  direccion    String?
  tipoCliente  String       @default("bronce")
  conexiones   Conexion[]
  pedidos      Pedido[]
  createdAt    DateTime     @default(now())
}

enum PersonalRol {
  admin
  gerente
  trabajador
  delivery
}

model Personal {
  id           Int          @id @default(autoincrement())
  nombre       String
  apellido     String
  cedula       String       @unique
  correo       String       @unique
  password     String
  telefono     String?
  rol          PersonalRol  @default(trabajador)
  status       Boolean      @default(true)
  sucursalId   Int?
  sucursal     Sucursal?    @relation(fields: [sucursalId], references: [id])
  pedidosAsignados Pedido[] @relation("Repartidor")
  createdAt    DateTime     @default(now())
}

// --- INFRAESTRUCTURA Y MERCADO ---
model Sucursal {
  id              Int          @id @default(autoincrement())
  nombre          String
  ciudad          String
  direccion       String
  coordenadasLat  Float
  coordenadasLng  Float
  tipo            String       @default("secundaria")
  status          Boolean      @default(true)
  personal        Personal[]
  inventarios     Inventario[]
  pedidos         Pedido[]
  informes        InformeAnalitico[]
}

model Competidor {
  id              Int      @id @default(autoincrement())
  nombre          String
  ciudad          String
  direccion       String?
  coordenadasLat  Float
  coordenadasLng  Float
  cantReviews     Int      @default(0)
  ratingPromedio  Float?
  tipoNegocio     String?
  categories      String?  // JSON array serializado
  placeId         String?  @unique
  website         String?
  phone           String?
  ultimaVerif     DateTime @default(now())
  busquedas       CompetidoresBusqueda[]
}

model BusquedaCompetidor {
  id              Int                    @id @default(autoincrement())
  categorias      String                 // JSON array de categorías buscadas
  ciudades        String                 // JSON array de ciudades
  maxPlaces       Int
  createdAt       DateTime               @default(now())
  competidores    CompetidoresBusqueda[]

  @@unique([categorias, ciudades, maxPlaces])
}

model CompetidoresBusqueda {
  busquedaId       Int
  competidorId     Int
  busqueda         BusquedaCompetidor @relation(fields: [busquedaId], references: [id], onDelete: Cascade)
  competidor       Competidor         @relation(fields: [competidorId], references: [id], onDelete: Cascade)

  @@id([busquedaId, competidorId])
}

// --- PRODUCTOS E INVENTARIO ---
model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
}

model Producto {
  id              Int               @id @default(autoincrement())
  nombre          String
  tipo            String
  descripcion     String?
  precioBase      Float
  emailProveedor  String
  imagen          String?
  categoriaId     Int
  categoria       Categoria         @relation(fields: [categoriaId], references: [id])
  inventarios     Inventario[]
  detallesPedido  PedidoDetalle[]
}

model Inventario {
  id              Int       @id @default(autoincrement())
  sucursalId      Int
  productoId      Int
  stockActual     Int       @default(0)
  stockMinimo     Int       @default(5)
  cantVentas      Int       @default(0)
  estadoStock     String    @default("optimo")
  status          String    @default("disponible")
  ultimaReposicion DateTime @updatedAt

  sucursal        Sucursal  @relation(fields: [sucursalId], references: [id])
  producto        Producto  @relation(fields: [productoId], references: [id])

  @@unique([sucursalId, productoId])
}

// --- GEOIP CACHE (geolocalización por IP) ---
model GeoIP {
  id         Int          @id @default(autoincrement())
  ip         String       @unique
  proveedor  String?
  ciudad     String?
  pais       String?
  latitud    Float?
  longitud   Float?
  auditorias Auditoria[]
  updatedAt  DateTime     @updatedAt
}

// --- AUDITORÍA DE ACCESOS (todos los usuarios) ---
model Auditoria {
  id         Int      @id @default(autoincrement())
  ip         String
  ruta       String
  metodo     String
  clienteId  Int?
  geoIPId    Int?
  geoIP      GeoIP?   @relation(fields: [geoIPId], references: [id])
  createdAt  DateTime @default(now())
}

// --- RECOLECCIÓN DE DATOS (SENSORES) ---
model Conexion {
  id           Int      @id @default(autoincrement())
  clienteId    Int
  ip           String
  latitud      Float
  longitud     Float
  dispositivo  String?
  fecha        DateTime @default(now())
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
}

model Pedido {
  id           Int             @id @default(autoincrement())
  clienteId    Int
  sucursalId   Int
  repartidorId Int?
  total        Float
  status       String          @default("pendiente")
  fecha        DateTime        @default(now())
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  sucursal     Sucursal        @relation(fields: [sucursalId], references: [id])
  repartidor   Personal?       @relation("Repartidor", fields: [repartidorId], references: [id])
  detalles     PedidoDetalle[]
}

model PedidoDetalle {
  id           Int      @id @default(autoincrement())
  pedidoId     Int
  productoId   Int
  cantidad     Int
  precioUnit   Float
  pedido       Pedido   @relation(fields: [pedidoId], references: [id])
  producto     Producto @relation(fields: [productoId], references: [id])
}

// --- GESTIÓN ECONÓMICA ---
model GestionEconomica {
  id              Int      @id @default(autoincrement())
  monedaPrincipal String   @default("USD")
  bcvPrice        Float    @default(1)
  autoUpdate      Boolean  @default(true)
  updateFrequency String   @default("24H")
  lastUpdate      DateTime @default(now())
}

// --- INTELIGENCIA ARTIFICIAL ---
model InformeAnalitico {
  id               Int      @id @default(autoincrement())
  tipoAnalisis     String   // ventas, demanda_geo, comportamiento
  sucursalId       Int?
  rangoInicio      DateTime
  rangoFin         DateTime
  dataJson         Json     // Resultados del cruce de datos
  insightIA        String?  
  createdAt        DateTime @default(now())
  sucursal         Sucursal? @relation(fields: [sucursalId], references: [id])
}